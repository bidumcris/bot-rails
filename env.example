## Copiá este archivo a `.env` (NO se commitea) y completá valores.

# Telegram
TELEGRAM_BOT_TOKEN="PEGAR_TOKEN_AQUI"

# LLM local (Ollama) — default del proyecto
LLM_PROVIDER="ollama"
# En notebook: http://127.0.0.1:11434
# En el VPS (con túnel SSH -R): también http://127.0.0.1:11434  → ver DEPLOY_ORACLE.md
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_TIMEOUT="90"

# LLM cloud (opcional, si cambiás LLM_PROVIDER=openai)
# LLM_PROVIDER="openai"
# OPENAI_API_KEY="PEGAR_API_KEY"
# OPENAI_MODEL="gpt-4o-mini"

# API (opcional, si lo seteás protege /api/* con header X-Api-Token)
# API_TOKEN="un-token-largo"

# Notas de voz (Whisper en la VM; ver script/install_whisper_oracle.sh)
# WHISPER_BIN="/opt/whisper/whisper-cli"
# WHISPER_MODEL="/opt/whisper/models/ggml-base.bin"
# WHISPER_LANGUAGE="es"

# Dashboard (opcional, Basic Auth)
# DASHBOARD_USER="admin"
# DASHBOARD_PASS="cambia-esto"

# WhatsApp Meta (opcional — no necesario para Telegram)
# META_WA_VERIFY_TOKEN="..."
# META_WA_ACCESS_TOKEN="..."
# META_WA_PHONE_NUMBER_ID="..."
# META_WA_API_VERSION="v21.0"
