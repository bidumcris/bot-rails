#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config/environment"
require "telegram/bot"

token_raw = ENV["TELEGRAM_BOT_TOKEN"].to_s
token = token_raw.strip[/\d+:[A-Za-z0-9_-]+/]
abort "Falta TELEGRAM_BOT_TOKEN (pegá solo el token tipo 123:ABC...)" if token.blank?

HELP_TEXT = <<~TXT.strip
  🧾 Bot de gastos e ingresos (ARS)

  Registrar (texto o foto de comprobante):
  • hamburguesa 8500
  • cobro 84150 servicio pilates
  • transferencia 21mil de gime
  • 2 menús 9000 cada uno

  Consultas:
  • /resumen — mes actual (ingresos, gastos, balance)
  • /septiembre — un mes
  • /movimientos — últimos 10
  • /perfil — tu rubro de trabajo

  Otros:
  • /trabajo — cambiar a qué te dedicás
  • /borrarultimo — deshacer el último movimiento
  • /ayuda — esta ayuda
TXT

SPANISH_COMMANDS = [
  Telegram::Bot::Types::BotCommand.new(command: "inicio", description: "Empezar y configurar perfil"),
  Telegram::Bot::Types::BotCommand.new(command: "ayuda", description: "Ver comandos"),
  Telegram::Bot::Types::BotCommand.new(command: "resumen", description: "Resumen del mes actual"),
  Telegram::Bot::Types::BotCommand.new(command: "movimientos", description: "Últimos 10 movimientos"),
  Telegram::Bot::Types::BotCommand.new(command: "perfil", description: "Ver tu perfil"),
  Telegram::Bot::Types::BotCommand.new(command: "trabajo", description: "Cambiar a qué te dedicás"),
  Telegram::Bot::Types::BotCommand.new(command: "borrarultimo", description: "Borrar el último movimiento"),
  Telegram::Bot::Types::BotCommand.new(command: "telefono", description: "Asociar tu número")
].freeze

def ensure_user(message)
  telegram_user_id = message.from&.id&.to_s
  chat_id = message.chat&.id&.to_s
  raise "No pude leer telegram_user_id/chat_id" if telegram_user_id.blank? || chat_id.blank?

  user = User.find_or_create_by!(telegram_user_id: telegram_user_id)
  user.update!(telegram_chat_id: chat_id) if user.telegram_chat_id != chat_id
  user
end

def format_ars(amount_cents)
  pesos = amount_cents.to_i / 100.0
  format("$%.2f ARS", pesos)
end

def kind_label(kind)
  kind.to_s == "income" ? "Ingreso" : "Gasto"
end

def command_name(text)
  text.to_s.split(/\s+/, 2).first.to_s.sub(%r{\A/}, "").split("@", 2).first.downcase
end

def btn(label)
  Telegram::Bot::Types::KeyboardButton.new(text: label)
end

def occupation_keyboard
  Telegram::Bot::Types::ReplyKeyboardMarkup.new(
    keyboard: [
      [btn("Sistemas / desarrollo"), btn("Pilates / servicios")],
      [btn("Comercio"), btn("Empleado")],
      [btn("Otro")]
    ],
    resize_keyboard: true,
    one_time_keyboard: true
  )
end

def remove_keyboard
  Telegram::Bot::Types::ReplyKeyboardRemove.new(remove_keyboard: true)
end

def ask_occupation(bot, chat_id, intro: true)
  prefix = intro ? "Para categorizar mejor tus cobros y gastos, " : ""
  bot.api.send_message(
    chat_id: chat_id,
    text: "#{prefix}¿a qué te dedicás?",
    reply_markup: occupation_keyboard
  )
end

def send_profile(bot, chat_id, user)
  rubro = user.occupation.presence || "todavía no lo cargaste"
  bot.api.send_message(
    chat_id: chat_id,
    text: "👤 Perfil\nRubro: #{rubro}\nMoneda: #{user.currency}\nZona: #{user.time_zone}"
  )
end

def resolve_amount_and_kind(text, extracted)
  amount_cents, description, kind = ExpenseTextParser.parse(text)
  kind = extracted.kind if extracted&.kind.present?

  if text.match?(/cada\s+(uno|una)\b/i) && extracted&.amount_cents.to_i.positive?
    amount_cents = extracted.amount_cents
  end

  description = extracted.description if extracted&.description.present? && description.blank?
  [amount_cents, description, kind]
end

def classify_entry(description, kind, extracted)
  if extracted&.category.present?
    ExpenseClassifier::Category.new(
      category: extracted.category,
      subcategory: extracted.subcategory,
      confidence: extracted.confidence
    )
  else
    ExpenseClassifier.new.classify(description, kind: kind)
  end
end

def send_month_summary(bot, chat_id, user, query_text)
  range = ExpenseMonthSummary.parse_month_query(query_text)
  if range.nil?
    bot.api.send_message(
      chat_id: chat_id,
      text: "No entendí el mes. Probá: /septiembre  /mes septiembre  /mes 9  /resumen"
    )
    return
  end

  from, to = range
  result = ExpenseMonthSummary.for_user(user, from: from, to: to)
  bot.api.send_message(
    chat_id: chat_id,
    text: ExpenseMonthSummary.format_message(result, format_ars: method(:format_ars))
  )
end

def send_recent(bot, chat_id, user, limit: 10)
  expenses = user.expenses.order(spent_at: :desc).limit(limit)
  if expenses.empty?
    bot.api.send_message(chat_id: chat_id, text: "Todavía no tenés movimientos registrados.")
    return
  end

  lines = ["🧾 Últimos #{expenses.size} movimientos:"]
  expenses.each do |e|
    day = e.spent_at.in_time_zone.strftime("%d/%m")
    sign = e.income? ? "+" : "-"
    lines << "• #{day} #{sign}#{format_ars(e.amount_cents)} — #{kind_label(e.kind)}/#{e.category} — #{e.description}"
  end
  bot.api.send_message(chat_id: chat_id, text: lines.join("\n"))
end

def extract_for(user, text, ai)
  ai.extract(text, currency: user.currency, occupation: user.occupation)
end

def persist_movement(user, amount_cents:, description:, kind:, extracted:, raw_text:, metadata:)
  cat = classify_entry(description, kind, extracted)
  user.expenses.create!(
    amount_cents: amount_cents,
    currency: user.currency,
    description: description,
    category: cat.category,
    subcategory: cat.subcategory,
    kind: kind,
    spent_at: Time.zone.now,
    raw_text: raw_text,
    llm_provider: extracted.provider,
    llm_model: extracted.model,
    llm_confidence: cat.confidence,
    metadata: metadata
  )
end

def download_telegram_file(token, file_path, message_id)
  url = "https://api.telegram.org/file/bot#{token}/#{file_path}"
  dir = Rails.root.join("tmp/receipts")
  FileUtils.mkdir_p(dir)
  ext = File.extname(file_path.to_s)
  ext = ".jpg" if ext.blank?
  dest = dir.join("#{message_id}#{ext}")
  res = HTTPX.with(timeout: { connect_timeout: 10, read_timeout: 30 }).get(url.to_s)
  return nil if res.is_a?(HTTPX::ErrorResponse) || res.status.to_i != 200

  File.binwrite(dest, res.to_s)
  dest
end

def handle_photo(bot, token, message, user, ai)
  photo = Array(message.photo).max_by { |p| p.file_size.to_i }
  return bot.api.send_message(chat_id: message.chat.id, text: "No pude leer la foto.") unless photo

  file = bot.api.get_file(file_id: photo.file_id)
  path = download_telegram_file(token, file.file_path, message.message_id)
  unless path
    bot.api.send_message(chat_id: message.chat.id, text: "No pude descargar la foto. Probá de nuevo.")
    return
  end

  caption = message.caption.to_s.strip
  ocr_text = ReceiptOcr.extract_text(path)
  combined = [caption, ocr_text].compact_blank.join("\n")

  unless ReceiptOcr.available?
    user.draft_expenses.create!(
      raw_text: caption.presence || "comprobante foto",
      extracted: { "description" => caption.presence || "comprobante", "kind" => "expense", "source" => "photo" },
      state: "awaiting_amount"
    )
    bot.api.send_message(
      chat_id: message.chat.id,
      text: "Recibí la foto. Todavía no hay OCR en este servidor.\nEscribí el monto y de qué fue, ej: super 12500 o cobro 84150 pilates."
    )
    return
  end

  if combined.blank?
    user.draft_expenses.create!(
      raw_text: "comprobante foto",
      extracted: { "description" => "comprobante", "kind" => "expense", "source" => "photo" },
      state: "awaiting_amount"
    )
    bot.api.send_message(chat_id: message.chat.id, text: "Vi la foto pero no pude leer el texto. ¿Cuánto fue y de qué?")
    return
  end

  extracted = extract_for(user, combined, ai)
  amount_cents, description, kind = resolve_amount_and_kind(combined, extracted)

  if amount_cents.nil?
    user.draft_expenses.create!(
      raw_text: combined,
      extracted: { "description" => description, "kind" => kind, "source" => "photo_ocr" },
      state: "awaiting_amount"
    )
    bot.api.send_message(
      chat_id: message.chat.id,
      text: "Leí el comprobante pero no encontré el monto.\nTexto: \"#{combined.truncate(180)}\"\n¿Cuánto fue en ARS?"
    )
    return
  end

  expense = persist_movement(
    user,
    amount_cents: amount_cents,
    description: description,
    kind: kind,
    extracted: extracted,
    raw_text: combined,
    metadata: { flow: "photo_ocr" }
  )
  bot.api.send_message(
    chat_id: message.chat.id,
    text: "#{kind_label(expense.kind)} (foto): #{format_ars(expense.amount_cents)} — #{[expense.category, expense.subcategory].compact.join(" / ")} — #{expense.description}"
  )
end

Telegram::Bot::Client.run(token) do |bot|
  ai = ExpenseAiExtractor.new
  bot.api.set_my_commands(commands: SPANISH_COMMANDS, language_code: "es") rescue nil

  bot.listen do |message|
    case message
    when Telegram::Bot::Types::Message
      next if message.text.blank? && message.contact.blank? && message.photo.blank?

      user = ensure_user(message)
      text = message.text.to_s.strip
      cmd = command_name(text)

      if message.photo.present? && !user.needs_onboarding?
        handle_photo(bot, token, message, user, ai)
        next
      end

      if user.needs_onboarding? && !%w[inicio start ayuda help].include?(cmd)
        if text.start_with?("/") && text.present?
          bot.api.send_message(chat_id: message.chat.id, text: "Primero decime a qué te dedicás (podés escribirlo, ej: soy programador).")
          ask_occupation(bot, message.chat.id, intro: false)
          next
        end

        if text.blank?
          ask_occupation(bot, message.chat.id, intro: false)
          next
        end

        if text == "Otro"
          user.update!(onboarding_step: "ask_occupation_detail")
          bot.api.send_message(chat_id: message.chat.id, text: "Contame en una frase a qué te dedicás.", reply_markup: remove_keyboard)
          next
        end

        occupation = User.normalize_occupation(text)
        if occupation.present?
          user.update!(occupation: occupation, onboarding_step: nil)
          bot.api.send_message(chat_id: message.chat.id, text: "Perfecto, rubro: #{occupation}.\n\n#{HELP_TEXT}", reply_markup: remove_keyboard)
          next
        end

        user.update!(onboarding_step: "ask_occupation") unless user.onboarding_step.present?
        ask_occupation(bot, message.chat.id)
        next
      end

      if %w[inicio start].include?(cmd)
        if user.onboarded?
          bot.api.send_message(chat_id: message.chat.id, text: "Hola de nuevo (#{user.occupation}).\n\n#{HELP_TEXT}")
        else
          user.update!(onboarding_step: "ask_occupation")
          ask_occupation(bot, message.chat.id)
        end
        next
      end

      if %w[ayuda help].include?(cmd)
        bot.api.send_message(chat_id: message.chat.id, text: HELP_TEXT)
        next
      end

      if %w[perfil].include?(cmd)
        send_profile(bot, message.chat.id, user)
        next
      end

      if %w[trabajo].include?(cmd)
        user.update!(onboarding_step: "ask_occupation")
        ask_occupation(bot, message.chat.id, intro: false)
        next
      end

      if %w[movimientos ultimos últimos].include?(cmd)
        send_recent(bot, message.chat.id, user)
        next
      end

      if %w[borrarultimo borrar_ultimo deshacer].include?(cmd)
        last = user.expenses.order(created_at: :desc).first
        if last.nil?
          bot.api.send_message(chat_id: message.chat.id, text: "No hay nada para borrar.")
        else
          summary = "#{kind_label(last.kind)} #{format_ars(last.amount_cents)} — #{last.description}"
          last.destroy!
          bot.api.send_message(chat_id: message.chat.id, text: "Borré el último movimiento: #{summary}")
        end
        next
      end

      if %w[resumen mes].include?(cmd) || ExpenseMonthSummary::MONTHS.key?(cmd)
        query = text.sub(%r{\A/}, "").split("@", 2).first
        send_month_summary(bot, message.chat.id, user, query)
        next
      end

      if %w[telefono phone].include?(cmd)
        kb = Telegram::Bot::Types::ReplyKeyboardMarkup.new(
          keyboard: [[Telegram::Bot::Types::KeyboardButton.new(text: "Compartir mi contacto", request_contact: true)]],
          resize_keyboard: true,
          one_time_keyboard: true
        )
        bot.api.send_message(chat_id: message.chat.id, text: "Tocá para compartir tu número (opcional).", reply_markup: kb)
        next
      end

      if message.contact
        if message.contact.user_id.present? && message.contact.user_id.to_s != message.from&.id&.to_s
          bot.api.send_message(chat_id: message.chat.id, text: "Por seguridad, solo puedo guardar tu propio contacto.")
          next
        end

        phone = message.contact.phone_number.to_s
        phone = phone.start_with?("+") ? phone : "+#{phone}"
        user.update!(phone_e164: phone)
        bot.api.send_message(chat_id: message.chat.id, text: "OK. Teléfono asociado: #{phone}", reply_markup: remove_keyboard)
        next
      end

      if text.start_with?("/")
        bot.api.send_message(chat_id: message.chat.id, text: "Comando desconocido.\n\n#{HELP_TEXT}")
        next
      end

      draft = user.draft_expenses.order(created_at: :desc).find_by(state: "awaiting_amount")
      if draft && text.match?(/\d/)
        amount_cents, _, kind_from_amount = ExpenseTextParser.parse(text, currency: user.currency)
        if amount_cents.nil?
          bot.api.send_message(chat_id: message.chat.id, text: "No entendí el monto. Probá: 8500 o 23.000,50")
          next
        end

        description = draft.extracted["description"].presence || draft.raw_text
        kind = draft.extracted["kind"].presence || kind_from_amount || "expense"
        extracted = extract_for(user, description, ai)
        kind = extracted.kind if extracted.kind.present?
        expense = persist_movement(
          user,
          amount_cents: amount_cents,
          description: description,
          kind: kind,
          extracted: extracted,
          raw_text: draft.raw_text,
          metadata: { flow: "draft_amount" }
        )
        draft.destroy!
        bot.api.send_message(
          chat_id: message.chat.id,
          text: "#{kind_label(expense.kind)}: #{format_ars(expense.amount_cents)} — #{[expense.category, expense.subcategory].compact.join(" / ")} — #{expense.description}"
        )
        next
      end

      extracted = extract_for(user, text, ai)
      amount_cents, description, kind = resolve_amount_and_kind(text, extracted)

      if amount_cents.nil?
        user.draft_expenses.create!(
          raw_text: text,
          extracted: { "description" => description, "kind" => kind },
          state: "awaiting_amount"
        )
        bot.api.send_message(chat_id: message.chat.id, text: "¿Cuánto fue el monto en ARS para: \"#{description}\"?")
        next
      end

      expense = persist_movement(
        user,
        amount_cents: amount_cents,
        description: description,
        kind: kind,
        extracted: extracted,
        raw_text: text,
        metadata: { flow: "direct", parser: { amount_cents: amount_cents, kind: kind } }
      )

      bot.api.send_message(
        chat_id: message.chat.id,
        text: "#{kind_label(expense.kind)}: #{format_ars(expense.amount_cents)} — #{[expense.category, expense.subcategory].compact.join(" / ")} — #{expense.description}"
      )
    end
  rescue StandardError => e
    bot.api.send_message(chat_id: message.chat.id, text: "Error: #{e.class} - #{e.message}") rescue nil
  end
end
